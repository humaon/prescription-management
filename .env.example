NODE_ENV=development
PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: if set, Cloud Scheduler must send it as the x-cron-secret header
CRON_SECRET=

UPLOAD_DIR=uploads
# Firebase/Cloud Storage bucket for test reports (Cloud Run's disk is wiped on restart)
REPORTS_BUCKET=
# Base URL in doctor share links, e.g. https://api.example.com (default: request host)
PUBLIC_BASE_URL=

JWT_SECRET=top-class-super-secret-for-prescription-management-service
JWT_EXPIRES_IN=7d

OTP_LENGTH=6
OTP_EXPIRES_MIN=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=


MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/